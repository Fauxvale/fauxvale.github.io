<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>The Adventures of Jules — A SkyrimNet Field Journal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&family=Crimson+Pro:ital,wght@0,400;0,500;0,600;1,400;1,500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#14161a; --panel:#1a1d23; --panel2:#20242b; --text:#e8e4da; --dim:#98938a;
  --gold:#c9a45c; --steel:#7da3b8; --blood:#b0584e; --moss:#8ba06b; --violet:#a98cc0; --amber:#cf9a54;
  --line:rgba(232,228,218,.16); --line2:rgba(232,228,218,.09);
  --sidebar:300px; --content:1080px;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;max-width:100%;overflow-x:hidden}
body{background:var(--bg);color:var(--text);font-family:'Crimson Pro',Georgia,serif;font-size:18px;line-height:1.6;
  background-image:radial-gradient(ellipse at 50% -10%, rgba(201,164,92,.06), transparent 60%);}
h1,h2,h3,.disp,.eyebrow,.kicker-up{font-family:'Oswald',sans-serif}
a{color:var(--gold)}
.mono{font-family:'JetBrains Mono',monospace}
::selection{background:rgba(201,164,92,.3)}

/* Tab bar */
.tabbar{position:sticky;top:0;z-index:40;display:flex;justify-content:center;gap:0;
  background:rgba(20,22,26,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.tabbtn{font-family:'Oswald',sans-serif;text-transform:uppercase;letter-spacing:.22em;font-size:.82rem;
  background:none;border:none;color:var(--dim);padding:16px 26px;cursor:pointer;position:relative;font-weight:500}
.tabbtn[aria-selected="true"]{color:var(--gold)}
.tabbtn[aria-selected="true"]::after{content:"";position:absolute;left:14%;right:14%;bottom:-1px;height:2px;background:var(--gold)}
.tabbtn:focus-visible{outline:2px solid var(--gold);outline-offset:2px}

/* Mobile TOC bar */
.mtoc{display:none;position:sticky;top:52px;z-index:35;align-items:center;gap:12px;
  padding:9px 16px;border-bottom:1px solid var(--line);
  background:linear-gradient(90deg, rgba(201,164,92,.14), rgba(26,29,35,.96) 55%)}
.mtoc .mbadge{font-family:'Oswald';font-size:.72rem;letter-spacing:.15em;color:var(--gold);
  border:1px solid var(--gold);border-radius:3px;padding:2px 7px}
.mtoc .mcur{font-family:'Oswald';text-transform:uppercase;letter-spacing:.12em;font-size:.78rem;color:var(--text);flex:1;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mtoc .mtab{font-family:'JetBrains Mono';font-size:.62rem;color:var(--dim);text-transform:uppercase;letter-spacing:.1em}
.hamb{background:none;border:1px solid var(--line);border-radius:4px;color:var(--text);width:34px;height:30px;cursor:pointer;
  display:flex;flex-direction:column;justify-content:center;align-items:center;gap:4px;padding:0}
.hamb span{display:block;width:16px;height:2px;background:var(--text)}

/* Mobile overlay */
.overlay{display:none;position:fixed;inset:0;z-index:60;background:rgba(15,16,20,.985);padding:26px 20px;overflow:auto}
.overlay.open{display:block}
.overlay h4{font-family:'Oswald';text-transform:uppercase;letter-spacing:.2em;color:var(--gold);font-size:.8rem;margin:0 0 6px}
.overlay .ovclose{position:absolute;top:16px;right:18px;background:none;border:none;color:var(--dim);font-size:2rem;cursor:pointer;line-height:1}
.overlay ol{list-style:none;margin:14px 0 0;padding:0}
.overlay li{display:flex;align-items:center;gap:14px;padding:15px 6px;border-bottom:1px solid var(--line2);cursor:pointer}
.overlay li .ob{font-family:'Oswald';font-size:.85rem;color:var(--gold);border:1px solid var(--line);border-radius:3px;
  min-width:38px;text-align:center;padding:4px 0}
.overlay li .ol{font-family:'Oswald';text-transform:uppercase;letter-spacing:.1em;font-size:1rem}

/* Floating TOC */
.toc{position:fixed;left:24px;top:50%;transform:translateY(-50%);z-index:30;width:240px}
.toc .tlabel{font-family:'JetBrains Mono';font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:var(--dim);margin-bottom:12px;padding-left:6px}
.toc ol{list-style:none;margin:0;padding:0}
.toc li{display:flex;align-items:center;gap:12px;padding:7px 6px;cursor:pointer;border-left:2px solid transparent;transition:.2s}
.toc li .badge{font-family:'Oswald';font-size:.72rem;color:var(--dim);border:1px solid var(--line);border-radius:3px;
  min-width:30px;text-align:center;padding:3px 0;transition:.2s}
.toc li .lab{font-family:'Oswald';text-transform:uppercase;letter-spacing:.08em;font-size:.8rem;color:var(--dim);transition:.2s}
.toc li:hover .lab{color:var(--text)}
.toc li.active{border-left-color:var(--gold)}
.toc li.active .badge{background:var(--gold);color:#14161a;border-color:var(--gold)}
.toc li.active .lab{color:var(--gold)}
.toc li:focus-visible{outline:2px solid var(--gold);outline-offset:2px}

/* Content column */
.wrap{max-width:var(--content);margin-left:auto;margin-right:auto;padding:0 22px 90px}
@media(min-width:1121px){
  .wrap{margin-left:max(var(--sidebar), calc((100vw - var(--content))/2));margin-right:auto}
}
@media(max-width:1120px){
  .toc{display:none}
  .mtoc{display:flex}
}

/* Header */
header.masthead{text-align:center;padding:54px 12px 30px;border-bottom:1px solid var(--line);position:relative}
.eyebrow{text-transform:uppercase;letter-spacing:.34em;font-size:.72rem;color:var(--gold);font-weight:500}
.kicker{font-style:italic;font-family:'Crimson Pro';color:var(--dim);font-size:1.15rem;margin:14px 0 2px}
.name{font-family:'Oswald';text-transform:uppercase;letter-spacing:.06em;font-weight:700;font-size:clamp(3rem,9vw,6.2rem);
  line-height:.98;margin:0;color:var(--text);text-shadow:0 2px 30px rgba(201,164,92,.12)}
.subtitle{font-style:italic;color:var(--dim);font-size:1.05rem;margin:16px auto 0;max-width:640px}
.stats{display:flex;flex-wrap:wrap;justify-content:center;gap:0;margin:28px auto 4px;max-width:860px}
.stat{padding:6px 22px;border-right:1px solid var(--line);text-align:center}
.stat:last-child{border-right:none}
.stat .v{font-family:'Oswald';font-weight:600;font-size:1.55rem;color:var(--gold);display:block;line-height:1.1}
.stat .k{font-family:'JetBrains Mono';font-size:.58rem;letter-spacing:.16em;text-transform:uppercase;color:var(--dim);margin-top:3px}

/* Sections */
.sec{border-top:1px solid var(--line2);padding-top:8px;margin-top:26px}
.sec:first-of-type{border-top:none}
.sechead{display:flex;align-items:center;gap:16px;cursor:pointer;padding:16px 2px;user-select:none}
.sechead:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
.sechead .rn{font-family:'JetBrains Mono';font-size:.8rem;color:var(--gold);min-width:34px}
.sechead .st{font-family:'Oswald';text-transform:uppercase;letter-spacing:.14em;font-weight:500;font-size:clamp(1.05rem,2.5vw,1.5rem);color:var(--text)}
.sechead .hr{flex:1;height:1px;background:var(--line);position:relative}
.sechead .hr::after{content:"";position:absolute;left:0;right:0;top:3px;height:1px;background:var(--line2)}
.sechead .chev{color:var(--dim);transition:transform .25s;font-size:1rem}
.sec.collapsed .chev{transform:rotate(-90deg)}
.secbody{overflow:hidden}
.sec.collapsed .secbody{display:none}
.seccap{color:var(--dim);font-style:italic;font-size:.98rem;margin:0 0 20px;max-width:70ch}

/* Timeline */
.tl{display:flex;align-items:flex-end;gap:10px;overflow-x:auto;padding:10px 0 4px;min-height:240px}
.tlday{display:flex;flex-direction:column;align-items:center;gap:8px;min-width:52px;flex:1}
.tlbar{width:34px;display:flex;flex-direction:column-reverse;border-radius:2px 2px 0 0;overflow:hidden;box-shadow:0 0 0 1px var(--line2)}
.tlseg{width:100%}
.tldl{font-family:'JetBrains Mono';font-size:.56rem;color:var(--dim);text-align:center;line-height:1.25;white-space:nowrap}
.tldt{font-family:'Oswald';font-size:.72rem;color:var(--text)}
.legend{display:flex;flex-wrap:wrap;gap:16px;margin:18px 0 6px}
.lg{display:flex;align-items:center;gap:7px;font-size:.82rem;color:var(--dim)}
.lg i{width:12px;height:12px;border-radius:2px;display:inline-block}

/* Chips */
.chips{display:flex;flex-wrap:wrap;gap:8px;margin:4px 0 16px}
.chip{font-family:'Oswald';text-transform:uppercase;letter-spacing:.08em;font-size:.72rem;color:var(--dim);
  background:var(--panel);border:1px solid var(--line);border-radius:20px;padding:6px 14px;cursor:pointer;transition:.15s}
.chip:hover{color:var(--text);border-color:var(--dim)}
.chip.on{color:#14161a;background:var(--gold);border-color:var(--gold)}
.chip .ct{font-family:'JetBrains Mono';font-size:.62rem;opacity:.7;margin-left:5px}
.chip:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
.keepvis{padding:2px 2px 8px}

/* Constellation */
.constel{position:relative;width:100%;background:radial-gradient(ellipse at 50% 40%, rgba(125,163,184,.05), transparent 70%);
  border:1px solid var(--line2);border-radius:6px;overflow:hidden}
.constel svg{display:block;width:100%;height:auto;touch-action:none}
.cstar{cursor:grab}
.cstar:active{cursor:grabbing}
.ctip{position:absolute;pointer-events:none;z-index:5;max-width:290px;background:rgba(16,18,22,.97);border:1px solid var(--line);
  border-radius:5px;padding:10px 12px;font-size:.82rem;opacity:0;transition:opacity .12s;box-shadow:0 8px 24px rgba(0,0,0,.5)}
.ctip .cta{font-family:'Oswald';text-transform:uppercase;letter-spacing:.08em;font-size:.7rem;margin-bottom:4px}
.ctip .ctm{font-family:'JetBrains Mono';font-size:.6rem;color:var(--dim);margin-top:6px}
.togline{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:2px 0 14px}
.toggle{display:inline-flex;border:1px solid var(--line);border-radius:20px;overflow:hidden}
.toggle button{font-family:'Oswald';text-transform:uppercase;letter-spacing:.1em;font-size:.7rem;background:none;border:none;
  color:var(--dim);padding:6px 16px;cursor:pointer}
.toggle button.on{background:var(--steel);color:#14161a}
.cnote{font-family:'JetBrains Mono';font-size:.62rem;color:var(--dim)}

/* Memories */
.daygrp{margin:8px 0 22px}
.dayhd{display:flex;align-items:baseline;gap:12px;border-bottom:1px solid var(--line2);padding-bottom:6px;margin-bottom:8px}
.dayhd .dn{font-family:'Oswald';text-transform:uppercase;letter-spacing:.1em;font-size:.95rem;color:var(--gold)}
.dayhd .dc{font-family:'JetBrains Mono';font-size:.62rem;color:var(--dim)}
.mrow{display:grid;grid-template-columns:150px 1fr 96px;gap:16px;padding:12px 4px;border-bottom:1px solid var(--line2);align-items:start}
.mrow .who{font-family:'Oswald';text-transform:uppercase;letter-spacing:.05em;font-size:.82rem}
.mrow .meta{font-family:'JetBrains Mono';font-size:.58rem;color:var(--dim);margin-top:4px;text-transform:uppercase;letter-spacing:.05em}
.mrow .mc{font-size:.96rem}
.mrow .mloc{font-family:'JetBrains Mono';font-size:.6rem;color:var(--dim);margin-top:5px}
.impwrap{text-align:right}
.impbar{height:5px;background:var(--line);border-radius:3px;overflow:hidden;margin-top:5px}
.impbar i{display:block;height:100%;background:var(--gold)}
.imptx{font-family:'JetBrains Mono';font-size:.56rem;color:var(--dim)}
.shown{font-family:'JetBrains Mono';font-size:.64rem;color:var(--dim);margin:2px 0 14px}
.syncnote{font-style:italic;color:var(--dim);font-size:.88rem;margin:0 0 14px}

/* Leaderboard */
.lb{display:flex;flex-direction:column;gap:2px}
.lbrow{display:grid;grid-template-columns:34px 150px 1fr;gap:14px;align-items:center;padding:12px 4px;border-bottom:1px solid var(--line2)}
.lbrank{font-family:'JetBrains Mono';font-size:.9rem;color:var(--dim)}
.lbname{font-family:'Oswald';text-transform:uppercase;letter-spacing:.05em;font-size:.92rem}
.lbtot{font-family:'JetBrains Mono';font-size:.66rem;color:var(--dim);margin-top:2px}
.lbbar{height:16px;display:flex;border-radius:3px;overflow:hidden;box-shadow:0 0 0 1px var(--line2);margin-bottom:7px}
.lbbar i{height:100%}
.vchips{display:flex;flex-wrap:wrap;gap:5px}
.vchip{font-family:'JetBrains Mono';font-size:.58rem;color:var(--dim);border:1px solid var(--line2);border-radius:12px;padding:2px 8px}

/* Diary */
.book{max-width:660px;margin:0 auto}
.page{background:linear-gradient(180deg,#1e2027,#1a1d23);border:1px solid var(--line);border-radius:5px;
  padding:34px 38px;box-shadow:0 20px 50px rgba(0,0,0,.4),inset 0 0 60px rgba(0,0,0,.25)}
.page .phd{display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid var(--line2);padding-bottom:10px;margin-bottom:16px}
.page .pau{font-family:'Oswald';text-transform:uppercase;letter-spacing:.14em;font-size:.82rem;color:var(--gold)}
.page .ppl{font-family:'JetBrains Mono';font-size:.6rem;color:var(--dim)}
.page .pbody{font-size:1.04rem;line-height:1.72}
.page .pbody p{margin:0 0 14px}
.page .pbody p:first-of-type::first-letter{font-family:'Oswald';font-weight:700;float:left;font-size:3.4rem;line-height:.8;
  padding:6px 10px 0 0;color:var(--gold)}
.flipbar{display:flex;justify-content:center;align-items:center;gap:20px;margin-top:18px}
.flipbar button{font-family:'Oswald';text-transform:uppercase;letter-spacing:.1em;font-size:.72rem;background:var(--panel);
  border:1px solid var(--line);color:var(--text);padding:8px 16px;border-radius:4px;cursor:pointer}
.flipbar button:disabled{opacity:.35;cursor:default}
.flipbar .pind{font-family:'JetBrains Mono';font-size:.66rem;color:var(--dim)}

/* OmniSight */
.portrait{background:linear-gradient(180deg,var(--panel2),var(--panel));border:1px solid var(--line);border-radius:6px;
  padding:30px 34px;margin-bottom:24px;position:relative}
.portrait h3{font-family:'Oswald';text-transform:uppercase;letter-spacing:.16em;font-size:1.05rem;color:var(--gold);margin:0 0 14px;text-align:center}
.portrait p{font-size:1.02rem;line-height:1.72;margin:0 0 14px}
.portrait p:first-of-type::first-letter{font-family:'Oswald';font-weight:700;float:left;font-size:3.2rem;line-height:.8;padding:5px 9px 0 0;color:var(--gold)}
.portrait .pfoot{font-family:'JetBrains Mono';font-size:.62rem;color:var(--dim);text-align:center;border-top:1px solid var(--line2);padding-top:12px;margin-top:6px}
.ogrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px}
.ocard{background:var(--panel);border:1px solid var(--line2);border-radius:5px;overflow:hidden;display:flex;flex-direction:column}
.ocard img{width:100%;aspect-ratio:16/9;object-fit:cover;background:#0e1013;display:block}
.ocard .obody{padding:12px 14px}
.ocard .on{font-family:'Oswald';text-transform:uppercase;letter-spacing:.06em;font-size:.82rem;color:var(--text)}
.ocard .om{font-family:'JetBrains Mono';font-size:.56rem;color:var(--dim);margin:4px 0 8px}
.ocard .od{font-size:.86rem;color:var(--dim);line-height:1.5}
.showmore{display:block;margin:22px auto 0;font-family:'Oswald';text-transform:uppercase;letter-spacing:.12em;font-size:.74rem;
  background:var(--panel);border:1px solid var(--line);color:var(--gold);padding:10px 26px;border-radius:4px;cursor:pointer}

/* Feature (Dagoth Ur) */
.feat{background:radial-gradient(ellipse at 50% 0%, rgba(176,88,78,.12), transparent 65%),var(--panel);
  border:1px solid var(--line);border-radius:6px;padding:30px 34px}
.feat .fintro p{font-size:1.02rem;line-height:1.7;margin:0 0 14px}
.feat .fstats{display:flex;flex-wrap:wrap;gap:0;margin:20px 0 24px;border-top:1px solid var(--line2);border-bottom:1px solid var(--line2)}
.feat .fs{padding:12px 22px;border-right:1px solid var(--line2);text-align:center}
.feat .fs:last-child{border-right:none}
.feat .fs .v{font-family:'Oswald';font-weight:600;font-size:1.4rem;color:var(--blood);display:block}
.feat .fs .k{font-family:'JetBrains Mono';font-size:.55rem;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);margin-top:2px}
.qgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px}
.qcard{background:var(--panel2);border:1px solid var(--line2);border-left:3px solid var(--blood);border-radius:4px;padding:14px 16px}
.qcard .qm{font-family:'JetBrains Mono';font-size:.56rem;color:var(--dim);text-transform:uppercase;letter-spacing:.06em;margin-bottom:7px}
.qcard .qc{font-size:.92rem;line-height:1.55}

/* Relations */
.relrow{display:grid;grid-template-columns:1fr 46% 1fr 60px;gap:14px;align-items:center;padding:11px 4px;border-bottom:1px solid var(--line2)}
.relrow .fa{text-align:right;font-family:'Oswald';text-transform:uppercase;letter-spacing:.04em;font-size:.8rem;cursor:help}
.relrow .fb{text-align:left;font-family:'Oswald';text-transform:uppercase;letter-spacing:.04em;font-size:.8rem;cursor:help}
.track{position:relative;height:8px;background:var(--line);border-radius:5px}
.track.war{box-shadow:0 0 10px rgba(176,88,78,.6)}
.track .tick{position:absolute;left:50%;top:-3px;bottom:-3px;width:1px;background:var(--dim)}
.track .seg{position:absolute;top:0;height:100%;border-radius:5px}
.relrow .sc{font-family:'JetBrains Mono';font-size:.82rem;text-align:right}
.wartag{font-family:'Oswald';font-size:.6rem;letter-spacing:.1em;color:var(--blood);border:1px solid var(--blood);border-radius:3px;padding:1px 5px;margin-left:6px;white-space:nowrap}

/* War */
.warpanel{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:24px 28px;margin-bottom:18px}
.warpanel.ongoing{border-color:rgba(176,88,78,.4)}
.warintro{font-style:italic;color:var(--dim);margin:0 0 18px;font-size:.96rem}
.versus{display:grid;grid-template-columns:1fr auto 1fr;gap:20px;align-items:center}
.side .sn{font-family:'Oswald';text-transform:uppercase;letter-spacing:.06em;font-size:1rem;margin-bottom:3px}
.side .sl{font-family:'JetBrains Mono';font-size:.58rem;color:var(--dim);margin-bottom:12px}
.side.r{text-align:right}
.gauge{margin:8px 0}
.gauge .gl{font-family:'JetBrains Mono';font-size:.56rem;text-transform:uppercase;letter-spacing:.1em;color:var(--dim);display:flex;justify-content:space-between}
.gbar{height:7px;background:var(--line);border-radius:4px;overflow:hidden;margin-top:3px}
.gbar i{display:block;height:100%}
.vs{font-family:'Oswald';text-transform:uppercase;letter-spacing:.1em;color:var(--blood);font-size:.86rem}
.warstatus{text-align:center;font-family:'JetBrains Mono';font-size:.62rem;letter-spacing:.08em;color:var(--gold);margin-top:16px;text-transform:uppercase}

/* Battles */
.battle{background:var(--panel);border:1px solid var(--line2);border-radius:5px;padding:16px 18px;margin-bottom:12px}
.battle .bh{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;margin-bottom:8px}
.battle .bl{font-family:'Oswald';text-transform:uppercase;letter-spacing:.08em;font-size:.92rem;color:var(--gold)}
.battle .br{font-family:'JetBrains Mono';font-size:.6rem;color:var(--dim)}
.battle .bn{font-size:.94rem;line-height:1.55;margin:0}
.battle .bloss{font-family:'JetBrains Mono';font-size:.6rem;color:var(--dim);margin-top:8px}

/* Chronicle */
.prov{display:grid;grid-template-columns:120px 1fr 60px;gap:14px;padding:11px 4px;border-bottom:1px solid var(--line2);align-items:start}
.provtag{font-family:'Oswald';text-transform:uppercase;letter-spacing:.06em;font-size:.6rem;padding:3px 8px;border-radius:3px;text-align:center;
  border:1px solid var(--line);color:var(--dim);height:fit-content}
.prov .pd{font-size:.92rem}
.prov .pp{font-family:'JetBrains Mono';font-size:.56rem;color:var(--dim);margin-top:4px;text-transform:uppercase;letter-spacing:.05em}
.prov .pdelta{font-family:'JetBrains Mono';font-size:.82rem;text-align:right}

/* Whispers */
.wstats{display:flex;flex-wrap:wrap;gap:0;margin-bottom:8px}
.wstat{padding:6px 20px;border-right:1px solid var(--line2);text-align:center}
.wstat:last-child{border-right:none}
.wstat .v{font-family:'Oswald';font-weight:600;font-size:1.3rem;color:var(--gold);display:block}
.wstat .k{font-family:'JetBrains Mono';font-size:.54rem;letter-spacing:.12em;text-transform:uppercase;color:var(--dim)}
.wgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
.wcard{background:var(--panel);border:1px solid var(--line2);border-top:3px solid var(--dim);border-radius:5px;padding:15px 17px;display:flex;flex-direction:column}
.wcard .wtags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:9px}
.wtag{font-family:'Oswald';text-transform:uppercase;letter-spacing:.08em;font-size:.56rem;padding:2px 7px;border-radius:3px}
.wcard .wh{font-family:'Oswald';text-transform:uppercase;letter-spacing:.06em;font-size:.74rem;margin-bottom:8px}
.wcard .wh .arr{color:var(--dim);margin:0 5px}
.wcard .wscene{font-style:italic;color:var(--dim);font-size:.86rem;margin-bottom:12px}
.wcard .wrumor{position:relative;font-size:1rem;line-height:1.5;padding-left:16px;border-left:2px solid var(--gold);margin-top:auto}
.wcard .wrumor::before{content:"\201C";position:absolute;left:-2px;top:-10px;font-size:1.8rem;color:var(--gold);opacity:.4;font-family:Georgia,serif}

footer{border-top:1px solid var(--line);margin-top:50px;padding:26px 22px 40px;text-align:center;font-style:italic;color:var(--dim);font-size:.86rem;line-height:1.6}

.hidden{display:none!important}
@media (prefers-reduced-motion: reduce){*{scroll-behavior:auto!important}}
@media(max-width:640px){
  .mrow{grid-template-columns:1fr;gap:6px}
  .impwrap{text-align:left}
  .relrow{grid-template-columns:1fr 1fr;grid-template-areas:"fa fb" "track track" "sc sc";gap:8px}
  .relrow .fa{grid-area:fa}.relrow .fb{grid-area:fb}.relrow .track{grid-area:track}.relrow .sc{grid-area:sc;text-align:left}
  .prov{grid-template-columns:1fr}
  .stat,.wstat{padding:6px 14px}
}
</style>
</head>
